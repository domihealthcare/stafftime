// Domi Staff (formerly Domi Time & Scheduling) — core data model
//
// Conventions (kept aligned with Domi EMR so a future merge is cheap):
//  - UUID primary keys
//  - snake_case table names via @@map, camelCase in the client
//  - all timestamps stored in UTC; each Location carries its own IANA timezone
//    so reporting stays correct if a location is ever added outside NJ
//  - Employee.externalId is the stable hook for linking to EMR staff records

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Migrations need a direct connection: they cannot run through a connection
  /// pooler. On a local database this is the same value as DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum EmploymentStatus {
  PENDING
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayType {
  HOURLY
  SALARY
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// How the punch was submitted.
enum ClockMethod {
  WEB
  MOBILE
  KIOSK
}

/// How we proved the employee was actually at the location.
enum VerificationMethod {
  GEOFENCE
  IP_ALLOWLIST
  KIOSK
  MANUAL
  /// Clocked in or out during a work-from-home shift: no office check, and
  /// no location or IP recorded.
  REMOTE
}

enum TimeEntryStatus {
  OPEN
  COMPLETED
  NEEDS_REVIEW
  APPROVED
}

enum PtoType {
  VACATION
  SICK
  PERSONAL
  BEREAVEMENT
  UNPAID
  OTHER
}

enum PtoStatus {
  PENDING
  APPROVED
  DENIED
  /// Withdrawn by the employee, or cancelled by a manager after approval.
  CANCELLED
}

// ---------------------------------------------------------------------------
// Location
// ---------------------------------------------------------------------------

/// A physical practice location. Carries the geofence and IP allow-list used to
/// verify clock-ins.
model Location {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  slug         String  @unique
  addressLine1 String
  addressLine2 String?
  city         String
  state        String  @db.Char(2)
  postalCode   String
  /// IANA timezone, e.g. "America/New_York".
  timezone     String  @default("America/New_York")

  /// Geofence centre. Decimal(9,6) gives ~11cm precision — plenty for a radius check.
  latitude           Decimal @db.Decimal(9, 6)
  longitude          Decimal @db.Decimal(9, 6)
  /// How far from the centre a web/mobile punch may be and still count as "at
  /// work".
  ///
  /// Feet, because the people setting it are in New Jersey and think in feet.
  /// The distance maths is metric underneath — a great-circle calculation
  /// returns metres — and converts once, at the comparison. Storing the unit
  /// somebody types avoids the alternative, where 500 feet is saved as 152
  /// metres and read back as 499, which looks like the app losing their input.
  geofenceRadiusFeet Int     @default(500)

  /// Fallback verification for web punches: exact IPv4/IPv6 addresses or IPv4 CIDR
  /// blocks (e.g. "203.0.113.7", "203.0.113.0/24") belonging to this office.
  allowedIps String[] @default([])

  /// Whether a location-bound kiosk session may be opened for this location.
  kioskEnabled Boolean @default(true)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees      EmployeeLocation[]
  shifts         Shift[]
  timeEntries    TimeEntry[]
  kioskDevices   KioskDevice[]
  payrollExports PayrollExport[]
  closingItems   ClosingItem[]
  closingRecords ClosingRecord[]
  supplyRequests SupplyRequest[]

  surveys Survey[]

  @@map("locations")
}

// ---------------------------------------------------------------------------
// Employee
// ---------------------------------------------------------------------------

model Employee {
  id String @id @default(uuid()) @db.Uuid

  /// Stable identifier for future Domi EMR linkage. Nullable today, unique when set,
  /// so staff records can be matched later without a messy migration.
  externalId String? @unique

  /// ADP TotalSource's "File #" for this person — ADP's own staff number,
  /// which every row of the payroll import file needs. Not an identity number:
  /// it means nothing outside the practice's ADP account. Null until an admin
  /// enters it; the ADP export names anybody still missing one.
  adpFileNumber String? @unique

  firstName      String
  lastName       String
  preferredName  String?
  email          String    @unique
  /// A number colleagues can reach them on, shown in the Directory. Their own
  /// to set on their profile; an admin can set it too.
  phone          String?
  /// Birthday — month and day only, never the year (decided with Dominguez,
  /// September 2026): enough for colleagues to wish somebody a happy
  /// birthday, without an age or a date of birth in the app. Shown on the
  /// home screen that week, on the Schedule and in the Directory. Set by an
  /// admin; both or neither.
  birthdayMonth Int?
  birthdayDay   Int?
  /// Optional, shown beside their name in the Directory ("she/her").
  pronouns       String?
  /// One line about themselves for the Directory, e.g. "Spanish speaker".
  about          String?
  /// When their profile photo last changed, or null for none. Doubles as the
  /// photo URL's version, so a new photo is never served from a stale cache.
  photoUpdatedAt DateTime?

  role             Role             @default(EMPLOYEE)
  employmentStatus EmploymentStatus @default(PENDING)
  payType          PayType          @default(HOURLY)

  /// Optional since September 2026 (Dominguez): not every start date was to
  /// hand on the first day. Without one, time off is not prorated and an
  /// onboarding checklist counts from the day it starts.
  hireDate        DateTime? @db.Date
  terminationDate DateTime? @db.Date

  /// Login credentials. Null until an admin sets a password, which is how a new
  /// hire's account exists before they can sign in.
  passwordHash       String?
  passwordUpdatedAt  DateTime?
  /// When a welcome email — a link to choose a first password — last went
  /// out. Null until one is sent; the Staff screen shows it so an admin knows
  /// who has been invited and who still needs to be.
  welcomeSentAt      DateTime?
  /// True for an admin-set temporary password: the holder must replace it before
  /// they can do anything else.
  mustChangePassword Boolean   @default(true)

  lastLoginAt         DateTime?
  /// Brute-force protection. Cleared on any successful sign-in.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Whether this manager gets the nightly round-up of what needs a look.
  ///
  /// On by default, and theirs to turn off. The digest only sends when there is
  /// something to say, so it is not noisy — but a practice with two managers
  /// and one admin does not need all three chasing the same lapsed licence, and
  /// an unwanted daily email is one that gets filtered, taking the one that
  /// mattered with it. Ignored for employees, who never receive it.
  wantsDailyDigest Boolean @default(true)

  photo EmployeePhoto?

  /// Secret used to build this employee's calendar subscription URL. Null until
  /// they ask for one. Rotating it invalidates the old link everywhere.
  calendarToken      String?   @unique
  calendarTokenSetAt DateTime?

  /// Kiosk credentials. The PIN is only ever stored hashed.
  pinHash           String?
  pinUpdatedAt      DateTime?
  /// PIN lockout is tracked separately from password lockout: someone fumbling
  /// the keypad at the front desk should not lose access to the web app too.
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  badgeId           String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      EmployeeLocation[]
  shifts         Shift[]
  timeEntries    TimeEntry[]
  closingRecords ClosingRecord[]
  sessions       Session[]

  createdShifts       Shift[]            @relation("ShiftCreatedBy")
  createdKiosks       KioskDevice[]      @relation("KioskCreatedBy")
  reportPresets       ReportPreset[]     @relation("ReportPresetOwner")
  ptoRequests         PtoRequest[]       @relation("PtoRequester")
  reviewedPtoRequests PtoRequest[]       @relation("PtoReviewer")
  editedPtoPolicies   PtoPolicy[]        @relation("PtoPolicyEditor")
  editedSettings      PracticeSettings[] @relation("PracticeSettingsEditor")
  editedTimeEntries   TimeEntry[]        @relation("TimeEntryEditedBy")
  approvedTimeEntries TimeEntry[]        @relation("TimeEntryApprovedBy")

  checklists                EmployeeChecklist[]     @relation("EmployeeChecklistSubject")
  createdChecklists         EmployeeChecklist[]     @relation("EmployeeChecklistCreatedBy")
  createdChecklistTemplates ChecklistTemplate[]     @relation("ChecklistTemplateCreatedBy")
  completedChecklistTasks   EmployeeChecklistTask[] @relation("ChecklistTaskCompletedBy")
  passwordResetTokens       PasswordResetToken[]    @relation("PasswordResetSubject")
  payrollExports            PayrollExport[]         @relation("PayrollExportGeneratedBy")
  credentials               EmployeeCredential[]    @relation("CredentialSubject")
  recordedCredentials       EmployeeCredential[]    @relation("CredentialRecordedBy")
  announcements             Announcement[]          @relation("AnnouncementAuthor")
  jobRoles                  EmployeeJobRole[]
  createdResources          Resource[]              @relation("ResourceCreatedBy")
  unavailability            Unavailability[]
  createdSurveys            Survey[]                @relation("SurveyCreatedBy")
  surveysTaken              SurveyParticipant[]
  notifications             Notification[]

  @@index([employmentStatus])
  @@map("employees")
}

/// An employee may be assigned to more than one location (North Bergen / West New York).
/// Clock-in is only permitted at an assigned location.
model EmployeeLocation {
  employeeId String   @db.Uuid
  locationId String   @db.Uuid
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([employeeId, locationId])
  @@index([locationId])
  @@map("employee_locations")
}

// ---------------------------------------------------------------------------
// PTO
// ---------------------------------------------------------------------------

/// The practice's time-off rules. One row, edited by an admin.
///
/// Kept as data rather than constants because these are a policy decision the
/// practice owns, and they will change — a new handbook, a new state rule, a
/// different carry-over. Defaults are Domi's starting point: 15 days PTO, 5
/// sick days, 5 days of PTO carried into the next year.
/// The practice's PTO rules. There is exactly one of these, and the database
/// enforces that: `singleton` is always 1 and is unique, so a second row cannot
/// be created even by two requests arriving at the same moment.
///
/// Without it, two concurrent first reads both find nothing and both insert,
/// and the practice quietly ends up with two policies — one of which nobody's
/// edits ever reach.
model PtoPolicy {
  id        String @id @default(uuid()) @db.Uuid
  singleton Int    @unique @default(1)

  /// Annual entitlement, in days.
  vacationDaysPerYear Int @default(15)
  sickDaysPerYear     Int @default(5)

  /// Unused days that survive into the next policy year, capped.
  maxCarryoverDays  Int @default(5)
  /// Sick days usually do not carry; kept separate so the practice can decide.
  sickCarryoverDays Int @default(0)

  /// When the policy year begins. 1 January by default; set to a different
  /// month and day if Domi ever runs PTO on a fiscal year.
  yearStartMonth Int @default(1)
  yearStartDay   Int @default(1)

  /// Give a mid-year starter a share of the year rather than the whole
  /// entitlement.
  prorateFirstYear Boolean @default(true)

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy Employee? @relation("PtoPolicyEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("pto_policy")
}

/// Practice-wide scheduling rules the managers set for themselves.
///
/// These started as constants in the code, which is the right place to start —
/// the numbers had to come from somewhere and nobody had an opinion yet. They
/// are here now because both turned out to be a guess standing in for something
/// only the practice knows: how far ahead Domi publishes a rota, and what it
/// treats as too many hours.
///
/// A database-enforced singleton, the same shape as `PtoPolicy` and for the
/// same reason — see the note on `PtoPolicyService.get`.
model PracticeSettings {
  id        String @id @default(uuid()) @db.Uuid
  singleton Int    @unique @default(1)

  /// Hours in a week past which the rota warns, and the payroll export splits.
  /// Forty is the federal line and New Jersey follows it; a practice that
  /// wanted to be told earlier could set it lower.
  overtimeThresholdHours Int @default(40)

  /// How close the coming week has to be before an unpublished rota is chased.
  /// Four days by default: close enough to be urgent, far enough to fix.
  rotaWarningDays Int @default(4)

  /// Any day a pay period began. Domi is paid every two weeks (confirmed
  /// September 2026), so every period is this date plus a multiple of 14 days.
  /// Null until an admin sets it; the "pay period" date shortcuts wait for it.
  payPeriodStart DateTime? @db.Date

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy Employee? @relation("PracticeSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("practice_settings")
}

/// What the ADP TotalSource import file is built from. One row, like
/// PracticeSettings, and apart from it because it is payroll's business.
///
/// The header and footer rows are copied from a worksheet the practice exported
/// out of its own TotalSource account — ADP's instructions say the import must
/// keep them. The employee rows of that worksheet are never stored. See
/// exports/payroll/adp-worksheet.ts.
model AdpSettings {
  id        String @id @default(uuid()) @db.Uuid
  singleton Int    @unique @default(1)

  /// ADP's company code, the "ccc" in PRcccEPI and the Co Code on every row.
  companyCode String?

  /// Verbatim, newline-separated, from the exported worksheet.
  headerRows String?
  footerRows String?

  /// Which of the worksheet's columns take regular and overtime hours.
  regularColumn  String?
  overtimeColumn String?

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("adp_settings")
}

/// A request for time off.
///
/// Dates are whole days (`@db.Date`), not timestamps: "the 3rd to the 7th"
/// means those days wherever the employee is, with no timezone to get wrong.
/// Half days are handled by `isHalfDay` on a single-day request rather than by
/// pretending a date is a time.
///
/// Balances and accrual are deliberately absent — the brief asks for requests
/// and approval, and how Domi accrues PTO is not settled. See
/// docs/open-questions.md.
model PtoRequest {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  type       PtoType
  status     PtoStatus @default(PENDING)

  /// Inclusive first and last day off.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// Only meaningful when startDate equals endDate.
  isHalfDay Boolean  @default(false)

  /// The employee's reason, optional — sick leave should not require one.
  notes String?

  reviewedById String?   @db.Uuid
  reviewedAt   DateTime?
  /// A manager's note, shown to the employee. Required when denying.
  reviewNote   String?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation("PtoRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy Employee? @relation("PtoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@map("pto_requests")
}

// ---------------------------------------------------------------------------
// Saved reports
// ---------------------------------------------------------------------------

/// A named set of export options — "Biweekly payroll", "North Bergen overtime".
///
/// The options are stored as JSON rather than columns because they are the
/// export screen's own shape, and every added option would otherwise be a
/// migration. They are re-validated against the export DTO on use, so a stale
/// or hand-edited preset cannot smuggle anything through.
model ReportPreset {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  ownerId  String  @db.Uuid
  /// Shared presets are visible to every manager, not just the person who made
  /// one. A small practice wants "the payroll export" to be the same export
  /// whoever runs it.
  isShared Boolean @default(false)
  options  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Employee @relation("ReportPresetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([isShared])
  @@map("report_presets")
}

// ---------------------------------------------------------------------------
// Kiosk
// ---------------------------------------------------------------------------

/// A tablet or front-desk PC bound to one location.
///
/// The device itself proves where a punch happened, which is why a kiosk punch
/// needs no geolocation. Binding is the whole security model here, so a device
/// is created for a specific location and cannot be moved — pair a new one
/// instead.
model KioskDevice {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  locationId String @db.Uuid

  /// SHA-256 of the long-lived device token. Null until the device is paired.
  tokenHash String? @unique

  /// SHA-256 of the short single-use pairing code an admin reads out to the
  /// device. Cleared the moment it is used, so a code cannot be replayed.
  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?

  pairedAt    DateTime?
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdById String?   @db.Uuid

  /// Wrong PINs at this time clock, whoever they were typed against, counted
  /// from `pinFailuresSince`. Each person has their own lockout too; this stops
  /// somebody at the desk trying a few PINs against every name in turn.
  pinFailures      Int       @default(0)
  pinFailuresSince DateTime?
  /// While set and in the future, the time clock takes no PINs at all.
  pinPausedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy Employee? @relation("KioskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@map("kiosk_devices")
}

// ---------------------------------------------------------------------------
// Session
// ---------------------------------------------------------------------------

/// A signed-in browser.
///
/// Sessions are server-side and opaque rather than self-contained tokens, so
/// access can be withdrawn the moment someone is offboarded instead of waiting
/// for a token to expire. Only the SHA-256 of the token is stored: a leaked
/// database row cannot be replayed as a login.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  /// SHA-256 of the opaque session token. The token itself is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  /// Recorded so a user can recognise their own sessions, and for incident review.
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Shift
// ---------------------------------------------------------------------------

/// A scheduled shift, built by a manager in the scheduler.
model Shift {
  id         String      @id @default(uuid()) @db.Uuid
  /// Who works it — or null for an **open shift**: a slot the practice needs
  /// filled (say Front Desk at North Bergen, 8 to 4) that nobody is on yet.
  /// Open shifts are flagged on the schedule and in the nightly round-up until
  /// somebody is put in them.
  employeeId String?     @db.Uuid
  locationId String      @db.Uuid
  /// What job the shift is for, when it matters — an open Front Desk shift
  /// should be filled from Front Desk. Optional: most assigned shifts are
  /// simply "Rosa, 8 to 5".
  jobRoleId  String?     @db.Uuid
  /// Worked from home. The location stays — it is the office the hours
  /// belong to — but clocking in during the shift needs no office check.
  isRemote   Boolean     @default(false)
  startsAt   DateTime
  endsAt     DateTime
  status     ShiftStatus @default(DRAFT)
  notes      String?

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  jobRole     JobRole?    @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  createdBy   Employee?   @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([employeeId, startsAt])
  @@index([locationId, startsAt])
  @@index([jobRoleId, startsAt])
  @@map("shifts")
}

// ---------------------------------------------------------------------------
// TimeEntry
// ---------------------------------------------------------------------------

/// One clock-in (and eventually clock-out) pair. Every punch records how it was
/// submitted and how it was verified, so a disputed timesheet can be reconstructed.
model TimeEntry {
  id         String          @id @default(uuid()) @db.Uuid
  employeeId String          @db.Uuid
  locationId String          @db.Uuid
  shiftId    String?         @db.Uuid
  method     ClockMethod
  status     TimeEntryStatus @default(OPEN)

  clockInAt             DateTime
  clockInLatitude       Decimal?           @db.Decimal(9, 6)
  clockInLongitude      Decimal?           @db.Decimal(9, 6)
  clockInAccuracyMeters Int?
  clockInIp             String?
  clockInVerification   VerificationMethod

  clockOutAt             DateTime?
  clockOutLatitude       Decimal?            @db.Decimal(9, 6)
  clockOutLongitude      Decimal?            @db.Decimal(9, 6)
  clockOutAccuracyMeters Int?
  clockOutIp             String?
  clockOutVerification   VerificationMethod?

  /// Flags surfaced to managers on the timesheet review screen.
  isLate           Boolean @default(false)
  isEarlyDeparture Boolean @default(false)
  isManuallyEdited Boolean @default(false)
  isMissingPunch   Boolean @default(false)

  /// Audit trail for manual edits and approvals.
  editedById   String?   @db.Uuid
  editedAt     DateTime?
  editReason   String?
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shift      Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  editedBy   Employee? @relation("TimeEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  approvedBy Employee? @relation("TimeEntryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  payrollExports PayrollExportEntry[]

  closingRecord ClosingRecord?

  @@index([employeeId, clockInAt])
  @@index([locationId, clockInAt])
  @@index([shiftId])
  @@map("time_entries")
}

// ---------------------------------------------------------------------------
// Onboarding / offboarding checklists (Phase 3)
// ---------------------------------------------------------------------------

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

/// Who is expected to do a task. Not a permission — an admin can complete
/// anything — but it tells a new hire which items are theirs.
enum TaskOwner {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum ChecklistTaskStatus {
  PENDING
  DONE
  /// Deliberately skipped, with a reason. Distinct from PENDING so an unfinished
  /// checklist cannot be mistaken for a finished one.
  NOT_APPLICABLE
}

/// A reusable list of tasks. Templates are edited freely; instances are
/// snapshots (see EmployeeChecklist), so editing one never rewrites history.
model ChecklistTemplate {
  id          String        @id @default(uuid()) @db.Uuid
  kind        ChecklistKind
  name        String
  description String?
  /// The template offered first when starting a checklist of this kind.
  isDefault   Boolean       @default(false)
  /// Retired templates stay for provenance but are not offered.
  archivedAt  DateTime?

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy Employee?               @relation("ChecklistTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     ChecklistTemplateTask[]
  instances EmployeeChecklist[]

  @@index([kind, archivedAt])
  @@map("checklist_templates")
}

model ChecklistTemplateTask {
  id          String    @id @default(uuid()) @db.Uuid
  templateId  String    @db.Uuid
  /// Display order within the template. Gaps are fine.
  position    Int
  title       String
  description String?
  owner       TaskOwner @default(ADMIN)

  /// Due date relative to the anchor date of the instance — the hire date for
  /// onboarding, the last day for offboarding. Negative means before it.
  dueOffsetDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@map("checklist_template_tasks")
}

/// One person's checklist. The tasks are copied from the template at creation
/// rather than referenced, because a signed I-9 recorded against a task whose
/// wording later changed is a compliance problem, not a convenience.
model EmployeeChecklist {
  id         String        @id @default(uuid()) @db.Uuid
  employeeId String        @db.Uuid
  kind       ChecklistKind
  /// Name copied from the template, so it reads correctly even if the template
  /// is renamed or retired.
  name       String
  /// Provenance only. Null if the template was deleted.
  templateId String?       @db.Uuid

  /// Hire date for onboarding, last day for offboarding. Task due dates hang off it.
  anchorDate  DateTime  @db.Date
  completedAt DateTime?

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee                @relation("EmployeeChecklistSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy Employee?               @relation("EmployeeChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  template  ChecklistTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks     EmployeeChecklistTask[]

  @@index([employeeId, kind])
  @@index([completedAt])
  @@map("employee_checklists")
}

model EmployeeChecklistTask {
  id          String    @id @default(uuid()) @db.Uuid
  checklistId String    @db.Uuid
  position    Int
  title       String
  description String?
  owner       TaskOwner @default(ADMIN)

  dueAt DateTime? @db.Date

  status ChecklistTaskStatus @default(PENDING)
  /// Why a task was marked not applicable, or any note left when completing it.
  note   String?

  completedById String?   @db.Uuid
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy Employee?         @relation("ChecklistTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([checklistId, position])
  @@index([status, dueAt])
  @@map("employee_checklist_tasks")
}

// ---------------------------------------------------------------------------
// File storage
// ---------------------------------------------------------------------------

/// Bytes held by the database file-storage adapter (see src/storage). Kept in
/// its own table, with no foreign key to whatever references it, so the adapter
/// stays a storage backend and knows nothing about checklists — swapping in a
/// blob store later touches only src/storage.
///
/// Listing documents never touches this table, so a file listing cannot
/// accidentally pull megabytes of PDFs into memory.
model StoredFile {
  storageKey String   @id
  bytes      Bytes
  createdAt  DateTime @default(now())

  @@map("stored_files")
}

// ---------------------------------------------------------------------------
// Login attempts (per-address throttling)
// ---------------------------------------------------------------------------

/// One row per *failed* sign-in, used to throttle an address that is guessing.
///
/// In the database rather than in memory because the production deployment is
/// serverless: an in-memory counter lives in one instance and an attacker's
/// next request lands in another, so it would count almost nothing.
///
/// The email is stored hashed. The throttle needs to know how many *different*
/// accounts an address has gone after, not which — and a plaintext column here
/// would be a standing list of who somebody tried to sign in as.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  ipAddress String
  emailHash String
  at        DateTime @default(now())

  @@index([ipAddress, at])
  @@index([at])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------------
// Password reset
// ---------------------------------------------------------------------------

/// A one-time link for setting a new password.
///
/// Only the hash is stored, for the same reason session tokens are: a database
/// dump must not hand somebody a working link into every account. Single use,
/// short lived, and every other outstanding token for that employee is spent
/// the moment one is used.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Where the request came from, for working out afterwards who was knocking.
  requestedIp String?
  createdAt   DateTime  @default(now())

  employee Employee @relation("PasswordResetSubject", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Payroll export
// ---------------------------------------------------------------------------

enum PayrollExportStatus {
  GENERATED
  /// The run failed. Kept rather than deleted, because "we tried and it did not
  /// work" is part of the audit trail.
  FAILED
  /// Superseded by a later run of the same period, or withdrawn. The file stays
  /// readable; it is simply no longer the one that went to payroll.
  VOIDED
}

/// One run of a payroll export.
///
/// The brief asks for this so an export can be re-run or audited, and that is
/// exactly what it is for: which hours left the building, for what period, to
/// which system, produced by whom, and the file itself — byte for byte, so a
/// disagreement with payroll six weeks later can be settled by looking rather
/// than by re-deriving from data that may since have changed.
model PayrollExport {
  id String @id @default(uuid()) @db.Uuid

  /// Which exporter produced it — "spreadsheet", "adp-totalsource". A string
  /// rather than an enum so adding a provider is a new class, not a migration.
  target String
  status PayrollExportStatus @default(GENERATED)

  /// Whole days, inclusive, like every other date range in this app.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /// Null when the run covered every location.
  locationId  String?  @db.Uuid

  /// What the file looked like. Kept even when the bytes are gone.
  filename    String
  contentType String
  sizeBytes   Int
  /// SHA-256 of the bytes, so "is this the file we sent?" has an answer.
  checksum    String
  /// The bytes, through the storage adapter. Null once a retention sweep has
  /// removed them, leaving the record behind.
  storageKey  String?

  /// What it contained, so the numbers can be checked without opening the file.
  entryCount    Int
  employeeCount Int
  totalHours    Decimal @db.Decimal(10, 2)

  /// Everything needed to run exactly this export again.
  options Json

  failureReason String?

  generatedById String?  @db.Uuid
  generatedAt   DateTime @default(now())

  generatedBy Employee?            @relation("PayrollExportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  location    Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  entries     PayrollExportEntry[]

  @@index([periodStart, periodEnd])
  @@index([generatedAt])
  @@map("payroll_exports")
}

/// Which time entries went out in which run.
///
/// The date range alone is not enough: an entry created or corrected later
/// falls inside the same range but was not in the file, and the difference is
/// the whole point of asking "have these hours been paid yet?".
model PayrollExportEntry {
  exportId    String @db.Uuid
  timeEntryId String @db.Uuid

  export    PayrollExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry     @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@id([exportId, timeEntryId])
  @@index([timeEntryId])
  @@map("payroll_export_entries")
}

// ---------------------------------------------------------------------------
// Licences and certifications
// ---------------------------------------------------------------------------

enum CredentialKind {
  /// A state professional licence — medical, nursing, pharmacy.
  LICENSE
  /// Board certification, or a specialty credential.
  CERTIFICATION
  /// CPR / BLS / ACLS card.
  LIFE_SUPPORT
  /// DEA registration, CLIA, NPI — anything with a renewal date.
  REGISTRATION
  IMMUNIZATION
  BACKGROUND_CHECK
  OTHER
}

/// Something with an expiry date that somebody has to renew.
///
/// Dates only, on purpose. This is a timekeeping app: it records *that* a
/// licence runs out on the 13th so the practice can be chased about it, and
/// deliberately does not hold the licence number or a scan of the document.
/// Those belong in the personnel file, wherever the practice keeps it.
///
/// Its own record rather than a field on a checklist document, because a
/// credential outlives the checklist it was first collected on: a licence
/// renews every couple of years, long after onboarding is finished, and the
/// renewal has nowhere to go if the only home is a one-off task.
///
/// For a medical practice this is the compliance risk that bites quietly —
/// nobody notices a lapsed licence until somebody asks for it.
model EmployeeCredential {
  id         String         @id @default(uuid()) @db.Uuid
  employeeId String         @db.Uuid
  kind       CredentialKind
  /// What it is, in the practice's own words: "NJ Registered Nurse licence".
  name       String
  /// Who issued it. Optional — not every credential has a meaningful issuer.
  issuer     String?
  issuedOn   DateTime?      @db.Date
  /// The whole point of the record. Whole days, like every other date here.
  expiresOn  DateTime       @db.Date

  notes String?

  /// Superseded by a renewal, or no longer relevant. Kept for the history.
  archivedAt DateTime?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee   Employee  @relation("CredentialSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy Employee? @relation("CredentialRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([employeeId, archivedAt])
  /// The query the whole feature exists for: what expires next.
  @@index([expiresOn, archivedAt])
  @@map("employee_credentials")
}

// ---------------------------------------------------------------------------
// Announcements (Phase 4)
// ---------------------------------------------------------------------------

/// A post on the staff noticeboard. Written by an admin, read by everyone who
/// is signed in — never shown on the public login page, which anyone on the
/// internet can open.
///
/// While any post exists, exactly one is primary: it is the first thing on the
/// home screen after sign-in. Prisma cannot express "at most one row where
/// isPrimary", so the migration adds a partial unique index for it, and the
/// service keeps "at least one" by moving the flag rather than clearing it.
model Announcement {
  id        String  @id @default(uuid()) @db.Uuid
  title     String
  /// Plain text. Line breaks are kept; nothing is interpreted as markup.
  body      String
  isPrimary Boolean @default(false)

  authorId String?   @db.Uuid
  /// Set when the words change after posting, so readers can tell.
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author Employee? @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// Job roles and resources (Phase 4)
// ---------------------------------------------------------------------------

/// What somebody does at the practice: Front Desk, Medical Assistant,
/// Provider… Managers keep the list and decide who is in each.
///
/// Not the same thing as `Employee.role`, which is what somebody may *do in
/// this app* (Employee / Manager / Admin). A job role called "Administrative"
/// decides which resources a person sees and nothing else — it grants no
/// access. The two are kept apart so that tidying the job list can never
/// quietly hand somebody the payroll export.
///
/// A person may hold several: some front desk staff also work as MAs.
model JobRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)
  /// A key from JOB_ROLE_COLOURS (src/job-roles/job-role-colours.ts), not a
  /// free hex: the set is validated for colour-blind readers as a whole.
  colour      String  @default("blue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              EmployeeJobRole[]
  resources            Resource[]
  surveys              Survey[]
  shifts               Shift[]
  /// Its closing checklist, shown at clock-out.
  closingSections      ClosingSection[]
  /// People in this role see their own licenses and onboarding under Team.
  /// Starts true for Provider only (September 2026).
  seesOwnPersonnelTabs Boolean           @default(false)

  @@map("job_roles")
}

model EmployeeJobRole {
  employeeId String   @db.Uuid
  jobRoleId  String   @db.Uuid
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobRole  JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@id([employeeId, jobRoleId])
  @@index([jobRoleId])
  @@map("employee_job_roles")
}

enum ResourceKind {
  /// Somewhere else: a Drive folder, ADP, a vendor portal.
  LINK
  /// Written here, in plain text: "How to open the North Bergen office".
  PAGE
}

/// Something a job role needs to hand: a link or a short written page.
///
/// Never a file. Nothing is uploaded to this app (see *Data this app does not
/// hold* in CLAUDE.md); a document lives where the practice already keeps it,
/// and a resource links to it.
///
/// `jobRoleId` null means everybody sees it.
model Resource {
  id        String       @id @default(uuid()) @db.Uuid
  jobRoleId String?      @db.Uuid
  kind      ResourceKind
  title     String
  /// For a LINK. Only http(s) — checked in the service.
  url       String?
  /// For a PAGE, or a line of explanation under a LINK.
  body      String?
  sortOrder Int          @default(0)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRole   JobRole?  @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  createdBy Employee? @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobRoleId, sortOrder])
  @@map("resources")
}

// ---------------------------------------------------------------------------
// Availability (Phase 4)
// ---------------------------------------------------------------------------

enum UnavailabilityKind {
  /// Every week on one weekday: "never Saturdays", "not Tuesdays after 5".
  WEEKLY
  /// One date: "not on 14 October".
  ONE_OFF
}

/// When somebody cannot work. Staff set their own; the scheduler warns when a
/// shift lands on it, but does not refuse — a manager sometimes has to ask.
///
/// Times are wall-clock times at the shift's location ("17:00"), not instants:
/// "after 5" means after 5 in North Bergen whatever the clocks did. Both null
/// means the whole day.
///
/// **A published week is fixed.** Staff may change their availability any time,
/// but a change only reaches weeks whose rota is not yet published — confirmed
/// by Dominguez, September 2026. So a weekly rule carries the dates it applies
/// between: a new one starts at the first open week, and removing one ends it
/// there rather than rewriting weeks people are already working to. A one-off
/// date inside a published week cannot be added or removed at all.
model Unavailability {
  id         String             @id @default(uuid()) @db.Uuid
  employeeId String             @db.Uuid
  kind       UnavailabilityKind

  /// WEEKLY only. ISO weekday: 1 = Monday … 7 = Sunday.
  weekday Int?
  /// ONE_OFF only.
  date    DateTime? @db.Date

  /// "HH:MM", local to the shift's location. Both null = all day.
  startTime String?
  endTime   String?
  note      String?

  /// The first day this counts. For a ONE_OFF, its date.
  effectiveFrom  DateTime  @db.Date
  /// The last day a WEEKLY rule counts, once somebody has removed it.
  effectiveUntil DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("unavailability")
}

// ---------------------------------------------------------------------------
// Pulse surveys and anonymous feedback (Phase 4)
// ---------------------------------------------------------------------------
//
// Truly anonymous, as Dominguez asked: nothing in these tables can connect a
// person to what they said. Answers carry no person and no time. Who has taken
// part is kept apart (so nobody answers twice, and a manager can see how many
// have), with no link to which answers were theirs. Results appear only once a
// survey is closed and at least three people answered — see
// docs/architecture.md for why "closed" as well as "three".
//
// `no-sensitive-data.spec.ts` fails if a person or a timestamp is ever added
// to the anonymous tables.

enum SurveyAudience {
  EVERYONE
  JOB_ROLE
  LOCATION
}

enum SurveyStatus {
  /// Being written. Nobody can see it but managers.
  DRAFT
  /// Can be answered. Its questions are frozen.
  OPEN
  /// Finished. Results show, if enough people answered.
  CLOSED
}

enum SurveyQuestionKind {
  /// 1 to 5.
  RATING
  /// One of a list.
  CHOICE
  /// Free text.
  TEXT
}

model Survey {
  id         String         @id @default(uuid()) @db.Uuid
  title      String
  intro      String?
  audience   SurveyAudience @default(EVERYONE)
  /// For JOB_ROLE. Null after the role is deleted, which leaves nobody to ask.
  jobRoleId  String?        @db.Uuid
  /// For LOCATION.
  locationId String?        @db.Uuid
  status     SurveyStatus   @default(DRAFT)
  openedAt   DateTime?
  closedAt   DateTime?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRole      JobRole?            @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  location     Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    Employee?           @relation("SurveyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  questions    SurveyQuestion[]
  responses    SurveyResponse[]
  participants SurveyParticipant[]

  @@index([status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String             @id @default(uuid()) @db.Uuid
  surveyId String             @db.Uuid
  position Int
  kind     SurveyQuestionKind
  prompt   String
  /// For CHOICE.
  options  String[]           @default([])

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId, position])
  @@map("survey_questions")
}

/// One person's answers — with no person, and no time.
model SurveyResponse {
  id       String @id @default(uuid()) @db.Uuid
  surveyId String @db.Uuid

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String  @id @default(uuid()) @db.Uuid
  responseId String  @db.Uuid
  questionId String  @db.Uuid
  rating     Int?
  choice     String?
  text       String?

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("survey_answers")
}

/// That somebody has answered — not what, and not when. Keeps anybody from
/// answering twice, and gives the manager a response count.
model SurveyParticipant {
  surveyId   String @db.Uuid
  employeeId String @db.Uuid

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([surveyId, employeeId])
  @@map("survey_participants")
}

/// The suggestion box. The message and the day it arrived; nothing else.
model Feedback {
  id         String    @id @default(uuid()) @db.Uuid
  message    String
  /// A day, not a time: to the minute, a timestamp says who was on their
  /// break when it arrived.
  receivedOn DateTime  @db.Date
  /// A manager has dealt with it.
  archivedAt DateTime?

  @@index([archivedAt, receivedOn])
  @@map("feedback")
}

/// A person's profile photo — the one thing staff upload to the app.
///
/// A deliberate, narrow exception to *Data this app does not hold* (decided
/// by Dominguez, September 2026): a picture of themselves that they choose,
/// that colleagues see in the Directory and the header. The browser crops it
/// square, shrinks it and re-encodes it as a small JPEG before it is sent —
/// which also drops the camera's metadata, location included — and the server
/// accepts nothing else. It is removable at any time, and goes with them if
/// the person is deleted.
model EmployeePhoto {
  employeeId  String   @id @db.Uuid
  bytes       Bytes
  contentType String
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_photos")
}

/// What happened that a notification is about. The words shown are stored with
/// it; this says which kind, for the icon and for tests.
enum NotificationKind {
  TIME_OFF_DECIDED
  TIME_OFF_REQUESTED
  OVERTIME
  SCHEDULE_CHANGED
  SURVEY_OPEN
  CHECKLIST_STARTED
  ANNOUNCEMENT
}

/// Something the app wants one person to know, shown under the bell in the
/// header — "your time off was approved", "your schedule changed".
///
/// One row per person per event, written at the moment it happens, with the
/// words as they were then: a notification is a record of being told, not a
/// live view, and reads the same tomorrow. It links to the screen where the
/// thing is. Nothing sensitive goes in it — the same wording an email would
/// carry, and often the same moment. Deleted by the nightly job after 90 days,
/// read or not.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  employeeId String           @db.Uuid
  kind       NotificationKind
  title      String
  body       String?
  /// A path inside the app, e.g. "/time-off".
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Closing checklists — what Front Desk and Medical Assistants confirm at
// clock-out (September 2026). The template belongs to a job role and is the
// managers' to edit; each clock-out keeps its own copy of the wording, so a
// later edit never rewrites what somebody ticked.
//
// Never anything about a patient: ticks, numbers and supplies only. There is
// deliberately no free-text box — see "Data this app does not hold".
// ---------------------------------------------------------------------------

enum ClosingItemKind {
  /// Ticked at clock-out; left unticked, it is flagged to managers.
  TASK
  /// A standing rule shown as a reminder, never ticked ("notify the doctor if
  /// vitals are out of range").
  REMINDER
  /// A number ("calls answered"); below its target, it is flagged.
  COUNT
  /// A supply ticked when more is needed; it goes on the office's restock list.
  SUPPLY
}

/// A heading in a role's closing checklist. A **position** section ("Check In
/// Desk", "Outdesk") is only shown when the person says they worked it today;
/// the rest are shown every time.
model ClosingSection {
  id         String  @id @default(uuid()) @db.Uuid
  jobRoleId  String  @db.Uuid
  title      String
  isPosition Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobRole JobRole       @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  items   ClosingItem[]

  @@index([jobRoleId, sortOrder])
  @@map("closing_sections")
}

model ClosingItem {
  id         String          @id @default(uuid()) @db.Uuid
  sectionId  String          @db.Uuid
  kind       ClosingItemKind @default(TASK)
  text       String
  /// COUNT only: at or above this is fine, below it is flagged.
  target     Int?
  /// ISO weekdays it applies on (1 = Monday … 7 = Sunday); empty is every day.
  weekdays   Int[]           @default([])
  /// One office only ("North Bergen office"); null is every office.
  locationId String?         @db.Uuid
  sortOrder  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section  ClosingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([sectionId, sortOrder])
  @@map("closing_items")
}

/// One clock-out's checklist. Written even when nothing was filled in — a
/// clock-out that skipped the checklist is itself worth a manager knowing.
model ClosingRecord {
  id          String   @id @default(uuid()) @db.Uuid
  timeEntryId String   @unique @db.Uuid
  employeeId  String   @db.Uuid
  locationId  String   @db.Uuid
  /// The working day, in the office's time zone.
  day         DateTime @db.Date
  /// Position sections they said they worked, by title as it was then.
  positions   String[] @default([])
  /// False when they clocked out without filling it in (a manager clocking
  /// them out, an old browser, a tablet that lost its connection).
  submitted   Boolean  @default(true)
  /// How many ticked tasks were missed and counts fell short — kept so the
  /// round-up does not have to reread every answer.
  gaps        Int      @default(0)
  createdAt   DateTime @default(now())

  timeEntry TimeEntry       @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location  Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  answers   ClosingAnswer[]

  @@index([day])
  @@index([employeeId, day])
  @@map("closing_records")
}

/// One line of one clock-out's checklist, with the wording as it was.
model ClosingAnswer {
  id        String          @id @default(uuid()) @db.Uuid
  recordId  String          @db.Uuid
  itemId    String?         @db.Uuid
  section   String
  kind      ClosingItemKind
  text      String
  target    Int?
  done      Boolean?
  count     Int?
  needed    Boolean?
  sortOrder Int             @default(0)

  record ClosingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("closing_answers")
}

/// A supply somebody ticked as needed, on its office's restock list until a
/// manager marks it ordered. One open line per supply per office: ticking it
/// again the next day adds a name, not a second line.
model SupplyRequest {
  id            String    @id @default(uuid()) @db.Uuid
  locationId    String    @db.Uuid
  itemId        String?   @db.Uuid
  text          String
  firstAskedAt  DateTime  @default(now())
  lastAskedAt   DateTime  @default(now())
  timesAsked    Int       @default(1)
  lastAskedById String?   @db.Uuid
  orderedAt     DateTime?
  orderedById   String?   @db.Uuid

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, orderedAt])
  @@map("supply_requests")
}
