# Postgres connection string.
# Matches the local database started by `npm run db:up` (docker-compose.yml).
DATABASE_URL="postgresql://stafftime:stafftime@localhost:5432/stafftime?schema=public"

# Migrations cannot run through a connection pooler, so they use this one.
# Locally it is the same value; on a hosted database it is the unpooled URL.
DIRECT_DATABASE_URL="postgresql://stafftime:stafftime@localhost:5432/stafftime?schema=public"

# API server
PORT=3000
NODE_ENV=development

# "production" or "test". Anything but production shows a standing banner on
# every screen, including sign-in and the kiosk, so nobody mistakes a review
# deployment for the one their hours are recorded in. Defaults to production, so
# a deployment is only ever a test environment on purpose.
APP_ENVIRONMENT=test

# How long a signed-in session lasts, and how long it may sit idle before it
# stops working. The idle timeout matters for the shared front-desk browser.
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_HOURS=8

# Brute-force protection on sign-in.
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

# Brute-force protection on the kiosk keypad. Tighter than the password limits,
# because a 4-digit PIN has far less entropy than a password.
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=10

# Minutes of grace before a punch is flagged late / early-departure against a shift.
PUNCH_GRACE_MINUTES=5

# Where uploaded checklist documents (I-9, W-4, signed handbook) are kept.
#
# "database" keeps the bytes in Postgres, which is the right answer for a
# practice this size: they inherit the database's backups and access control,
# there is no second account to set up, and there is no public URL for a file
# containing somebody's social security number.
#
# "disk" writes them under FILE_STORAGE_DIR instead. Handy locally — you can
# open the folder — but wrong on Vercel, where the filesystem is ephemeral and
# each serverless instance has its own.
FILE_STORAGE=database
FILE_STORAGE_DIR=./var/uploads

# Largest document that may be attached, in megabytes.
MAX_UPLOAD_MB=10
