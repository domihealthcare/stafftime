# Postgres connection string.
# Matches the local database started by `npm run db:up` (docker-compose.yml).
DATABASE_URL="postgresql://stafftime:stafftime@localhost:5432/stafftime?schema=public"

# Migrations cannot run through a connection pooler, so they use this one.
# Locally it is the same value; on a hosted database it is the unpooled URL.
DIRECT_DATABASE_URL="postgresql://stafftime:stafftime@localhost:5432/stafftime?schema=public"

# API server
PORT=3000
NODE_ENV=development

# "production" or "test". Anything but production shows a standing banner on
# every screen, including sign-in and the kiosk, so nobody mistakes a review
# deployment for the one their hours are recorded in. Defaults to production, so
# a deployment is only ever a test environment on purpose.
APP_ENVIRONMENT=test

# How long a signed-in session lasts, and how long it may sit idle before it
# stops working. The idle timeout matters for the shared front-desk browser.
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_HOURS=8

# Brute-force protection on sign-in.
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

# Brute-force protection on the kiosk keypad. Tighter than the password limits,
# because a 4-digit PIN has far less entropy than a password.
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=10

# Minutes of grace before a punch is flagged late / early-departure against a shift.
PUNCH_GRACE_MINUTES=5

# Where generated payroll export files are kept. Nothing else in this app
# stores a file: it records hours, not personnel documents.
#
# "database" keeps the bytes in Postgres, which is the right answer for a
# practice this size: they inherit the database's backups and access control,
# and there is no public URL for a file listing everybody's hours.
#
# "disk" writes them under FILE_STORAGE_DIR instead. Handy locally — you can
# open the folder — but wrong on Vercel, where the filesystem is ephemeral and
# each serverless instance has its own.
FILE_STORAGE=database
FILE_STORAGE_DIR=./var/uploads

# Per-address sign-in throttling, on top of per-account lockout. Counts how
# many *different* accounts an address has failed against, because both offices
# share one address and "N failures per IP" would lock the front desk out on a
# bad Monday. MAX_FAILURES is only a backstop, so it is set high.
#
# A throttled address does not stop the kiosk: PIN punches never go through the
# sign-in route.
LOGIN_THROTTLE_WINDOW_MINUTES=10
LOGIN_THROTTLE_MAX_ACCOUNTS=10
LOGIN_THROTTLE_MAX_FAILURES=60

# Shared secret for the scheduled housekeeping route (GET /api/maintenance/purge,
# called daily by Vercel Cron). Leave it unset locally: the route then refuses
# everything, rather than falling open.
#
# REQUIRED IN PRODUCTION. Commented out here so a local run does not need one,
# but Vercel reads this file to offer you a list of variables when you import
# the project — and a commented line is a line it will not offer. See DEPLOY.md.
# CRON_SECRET=

# One-time password that allows the first administrator account to be created,
# through the setup screen, and nothing else. Must be at least 8 characters.
#
# REQUIRED FOR A NEW DEPLOYMENT, then deleted: once the admin exists, the setup
# route refuses to run again, and the variable should come back out of the
# hosting config. Unset locally, where `npm run create-admin` does the job.
# SETUP_TOKEN=

# Where this deployment lives. Used to build the links in emails — a reset link
# pointing at localhost is no use to anybody.
APP_URL=http://localhost:5173

# Email. With either of these missing, messages are written to the server log
# instead of being sent — which is exactly what you want locally (a password
# reset link appears in the terminal) and loudly warned about in production.
#
# EMAIL_FROM has to be on a domain verified with the provider.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Domi Staff <no-reply@domihealthcare.com>
